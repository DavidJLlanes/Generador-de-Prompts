# Añadir dentro del bloque HTTPS existente de djl.com.es.
location = /prompt {
    return 301 /prompt/$is_args$args;
}

location ^~ /prompt/ {
    root /var/www/djl.com.es;
    index index.html;
    try_files $uri $uri/ =404;
    error_page 404 /prompt/404.html;

    # Protege el repositorio y los archivos de desarrollo bajo la raíz pública.
    location ~ /\. { deny all; }
    location ~ ^/prompt/(?:docs|deploy|scripts|tests|e2e|node_modules)(?:/|$) { deny all; }
    location = /prompt/package.json { deny all; }
}
