# Copiar a /etc/lumenvitae-ai.env, proteger con chmod 600 y completar en el VPS.
# Genera el token del sitio con: openssl rand -hex 32
AI_ACCESS_TOKEN=
AI_ALLOWED_ORIGIN=https://lumenvitae.es
AI_PUBLIC_SITE=https://lumenvitae.es

# Activa uno o varios proveedores. El modelo debe ser un ID admitido por la cuenta.
# OpenRouter también permite seleccionar modelos de muchos proveedores con una sola clave.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
